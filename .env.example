# Slack 集成（loop-conductor 通知 / 监控）
# 真实值写进 .env（已被 .gitignore 忽略），本文件只留占位说明。

# 发消息 / 读历史用（必需）。OAuth & Permissions 装到工作区后拿到，xoxb- 开头
SLACK_BOT_TOKEN=xoxb-...

# Socket Mode 实时监控用（要监控才填）。Basic Information → App-Level Tokens 生成，xapp- 开头
SLACK_APP_TOKEN=xapp-...

# 仅当走 Events API 的 HTTP 回调时才需要；用 Socket Mode 可留空
# SLACK_SIGNING_SECRET=

# conductor 默认发到哪个频道（频道 ID，C 开头；先 /invite @bot 进频道）
SLACK_DEFAULT_CHANNEL=[REDACTED-CHANNEL]    # = #will-loop-workflow

# （可选）告警通道 incoming webhook（tools/alerts-scan.mjs 优先走它；独立密钥可单独撤销）
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# （可选）error/critical 告警时 @ 谁（Slack mention 语法，如 <@U0XXXXXXX> 或 <!channel>）
# SLACK_ALERT_MENTION=